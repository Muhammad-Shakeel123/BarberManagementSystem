# Copy to .env.prod and fill in real values (that file is gitignored).
# Used by docker-compose.prod.yml for both `up` and `--profile setup run seed`.

# Public port the site is served on (behind a TLS proxy, use 8080 or similar).
WEB_PORT=80

# Authentication — generate with: openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Stripe (payments). The publishable key is baked into the frontend build.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# SMTP (notification emails; optional, emails fail at send time if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary (profile images; optional, uploads return 503 if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Timezone and scheduling rules
TIMEZONE=Asia/Karachi
MAX_FUTURE_DAYS=30
MIN_ADVANCE_MINUTES=30
NO_SHOW_GRACE_MINUTES=15
QUEUE_MAX_CAPACITY=50
SLOT_INTERVAL_MINUTES=15
