# Development placeholders for the Base44 sandbox environment.
#
# Every value below is a NON-FUNCTIONAL placeholder whose only job is to let the
# services boot before real credentials exist. This file is loaded as the FIRST
# env_file entry in docker-compose.base44.yml; the platform-managed secret file
# (/run/base44/app.env) is listed after it, so real credentials always win.
# Do not put real credentials here.

# --- Stripe (external service) ---------------------------------------------
# src/config/stripe.js constructs a Stripe client at import time, so the API
# needs a non-empty key to boot. Payments do not work until the real keys are
# provided as secrets (STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET).
STRIPE_SECRET_KEY=sk_test_base44_dev_placeholder
STRIPE_WEBHOOK_SECRET=

# --- Cloudinary (profile images, optional) ---------------------------------
# Unset means image upload endpoints answer 503 "Image upload is not configured".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP (email, optional) ------------------------------------------------
# Unset means notification emails fail; the rest of the app keeps working.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
